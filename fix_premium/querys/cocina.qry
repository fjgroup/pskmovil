SELECT 
  articulo.CAMPO1,
  articulo.CAMPO2,
  articulo.CAMPO3,
  articulo.ORIGEN,
  articulo.GARANTIA,
  articulo.REFERENCIA,
  operti.TIPODOC,
  operti.CODCLIENTE,
  operti.NOMBRECLI,
  operti.RIF,
  operti.NIT,
  operti.CONTACTO,
  IF(idconsumos.descripcion IS NOT NULL AND idconsumos.descripcion != '', 
     CONCAT('E', SUBSTRING(operti.DOCUMENTO, 2), ' - ', TRIM(idconsumos.descripcion)), 
     operti.DOCUMENTO) AS DOCUMENTO,
  operti.EMISION,
  operti.ESCREDITO,
  operti.ESTATUSDOC,
  operti.VENCE,
  operti.ORDEN,
  operti.ESTACION,
  operti.HORADOCUM,
  operti.AMPM,
  operti.FACTORCAMB,
  operti.NOTAS as notas_operti,
  operti.TOTALFINAL,
  operti.TOTBRUTO,
  operti.TOTDESCUEN,
  operti.TOTNETO,
  operti.TOTIMPUEST,
  operti.TOTPAGOS,
  operti.VUELTO,
  operti.DSCTOLINEA,
  operti.DSCTOEND2,
  operti.DSCTOEND1,
  operti.SINIMPUEST,
  cliempre.EMAIL,
  cliempre.TELEFONOS,
  cliempre.NUMEROFAX,
  cliempre.DIRECCION,
  cliempre.PERSCONT,
  opermv.CODIGO,
  opermv.VENDEDOR,
  opermv.NOMBRE as mvnombre,
  opermv.NOTAS as notas,
  opermv.UNIDAD,
  opermv.TIMPUEPRC,
  opermv.PRECIOFIN,
  opermv.CANTIDAD,
  opermv.MONTONETO,
  opermv.IMPU_MTO,
  opermv.PRECIOUNIT,
  opermv.DSCTOUNIT,
  opermv.MONTOTOTAL,
  opermv.DSCTOENDM,
  opermv.TALLAS,
  opermv.COLORES,
  opermv.IMP_NACIONAL,
  opermv.IMP_PRODUCC,
  opermv.CODHIJO,
  opermv.pid,
  opermv.AGRUPADO,
  opermv.GRUPO,
  grupos.FORMATO,
  listvend.NOMBRE as vnombre
FROM  

  Opermv 

  left JOIN operti     ON (operti.AGENCIA    = opermv.AGENCIA)
                      AND (operti.TIPODOC    = opermv.TIPODOC)
                      AND (operti.DOCUMENTO  = opermv.DOCUMENTO)

  left JOIN Cliempre   ON (cliempre.CODIGO   = operti.CODCLIENTE)

  Left JOIN listvend   ON (listvend.CODIGO   = operti.VENDEDOR)

  Left JOIN articulo   ON (articulo.CODIGO   = opermv.CODIGO)

  LEFT JOIN grupos     ON (grupos.codigo     = opermv.grupo)

  LEFT JOIN idconsumos ON (idconsumos.id_consumo = SUBSTRING(operti.DOCUMENTO, 2))

